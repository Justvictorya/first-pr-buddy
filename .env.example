# IBM Bob 2.0 (granted at hackathon kickoff, Sept 25)
# Set to 'true' to route per-module analysis through Bob 2.0 instead of the local analyzer
BOB_ENABLED=false
BOB_API_KEY=

# Optional: GitHub token — raises REST API rate limit from 60 to 5,000/hr and
# allows fetching issues from private repos. Used by the issues endpoint.
GITHUB_TOKEN=

# --- AI chat (optional) ---
# The chat falls back to keyword heuristics when no key is set, so the app
# works fully offline. Set GROQ_API_KEY to enable real AI answers — Groq is
# free and is the default provider.
# Provider priority: Groq (free) → OpenAI (paid) → Anthropic (paid) → heuristics.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Rate limiting ---
# Chat rate limit: 20 messages per hour per IP (in-memory, single-process).
# For multi-instance deployments, replace with a Redis-backed store.
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_MINUTES=60

# --- Caching ---
# In-memory cache holds up to 50 recent analyses for 10 minutes.
CACHE_TTL_MINUTES=10
CACHE_MAX_ENTRIES=50