# IBM Bob 2.0 (granted at hackathon kickoff, Sept 25)
# Set to 'true' to route per-module analysis through Bob 2.0 instead of the local analyzer
BOB_ENABLED=false
BOB_API_KEY=

# Optional: GitHub token — raises REST API rate limit from 60 to 5,000/hr and
# allows fetching issues from private repos. Used by the issues endpoint.
GITHUB_TOKEN=

# --- AI chat (optional) ---
# The chat falls back to keyword heuristics when no provider is configured, so
# the app works fully offline. Ollama is the default free provider — run it
# locally with `ollama serve` and pull a model with `ollama pull llama3.2:3b`.
# Provider priority: Ollama (free, local) -> OpenAI (paid) -> Anthropic (paid) -> heuristics.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Rate limiting ---
# Chat rate limit: 20 messages per hour per IP (in-memory, single-process).
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_MINUTES=60

# --- Caching ---
# In-memory cache holds up to 50 recent analyses for 10 minutes.
CACHE_TTL_MINUTES=10
CACHE_MAX_ENTRIES=50