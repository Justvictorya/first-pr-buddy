# IBM Bob 2.0 (granted at hackathon kickoff, Sept 25)
# Set to 'true' to route per-module analysis through Bob 2.0 instead of the local analyzer
BOB_ENABLED=false
BOB_API_KEY=

# Optional: GitHub token to raise API rate limits and allow private repos
GITHUB_TOKEN=

# --- AI chat (optional) ---
# The chat falls back to keyword heuristics when neither is set, so the app
# works fully offline. Set either key to enable real LLM answers.
# Provider priority: OpenAI → Anthropic → heuristics.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini          # OpenAI model override
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- Caching ---
# In-memory cache holds up to 50 recent analyses for 10 minutes. Set to a
# Redis URL (or any compatible KV store) in production to share cache across
# instances. Currently in-memory only.
CACHE_TTL_MINUTES=10
CACHE_MAX_ENTRIES=50